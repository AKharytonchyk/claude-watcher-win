<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClaudeWatcher.UI.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ClaudeWatcher.Core"
    xmlns:ui="using:ClaudeWatcher.UI">

    <UserControl.Resources>
        <ui:StateToBrushConverter x:Key="StateBrush" />
        <ui:ContextPctConverter x:Key="Pct" />
        <ui:ContextPctToBrushConverter x:Key="PctBrush" />
        <ui:BoolToVisibilityConverter x:Key="BoolVis" />
        <ui:StringToVisibilityConverter x:Key="StrVis" />
    </UserControl.Resources>

    <Grid x:Name="Root" Width="368" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, per-state count badges on the right -->
        <Grid Grid.Row="0" Padding="15,12,12,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Claude Agents" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind VM.Pills, Mode=OneWay}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ui:StatePill">
                        <!-- Doubles as the filter: click to hide/show that state -->
                        <Button Click="OnPillClick" Padding="8,3" MinWidth="0" MinHeight="0"
                                CornerRadius="11" Opacity="{x:Bind Dim}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="0" ToolTipService.ToolTip="{x:Bind Tip}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind State, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{x:Bind Count}" FontSize="11.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="No running agents"
                   Visibility="{x:Bind VM.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}"
                   HorizontalAlignment="Center" Margin="0,28" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Rows -->
        <ListView Grid.Row="2" x:Name="AgentList"
                  ItemsSource="{x:Bind VM.Agents, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="OnItemClick"
                  SelectionMode="None" Padding="6,4"
                  Visibility="{x:Bind VM.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                  MaxHeight="440">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:AgentView">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0"
                                 Fill="{x:Bind State, Converter={StaticResource StateBrush}}" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <!-- name  ·  state · elapsed -->
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind StateText}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind TimeText}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- last intent, the reason you opened this thing -->
                            <TextBlock Text="{x:Bind Intent}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind Intent, Converter={StaticResource StrVis}}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                            <!-- provenance · path · branch · context pressure -->
                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,1,0,0">
                                <TextBlock Text="{x:Bind OriginText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Location}" FontSize="11"
                                           MaxWidth="205" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <!-- open PR for this branch: click to open it in the browser.
                                     A Button (not a Border) so the click is swallowed here
                                     instead of also firing the row's focus-the-terminal. -->
                                <Button Click="OnPrClick" CornerRadius="9" Padding="6,1"
                                        MinWidth="0" MinHeight="0" BorderThickness="1"
                                        BorderBrush="#4D30A46C" Background="#1A30A46C"
                                        ToolTipService.ToolTip="{x:Bind PrTooltip}"
                                        Visibility="{x:Bind PrText, Converter={StaticResource StrVis}}">
                                    <TextBlock Text="{x:Bind PrText}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#3FBF7F" />
                                </Button>

                                <TextBlock Text="{x:Bind ContextPct, Converter={StaticResource Pct}}" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ContextPct, Converter={StaticResource PctBrush}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- affordance for "clicking this row focuses the host window" -->
                        <FontIcon Grid.Column="2" Glyph="&#xE756;" FontSize="13" VerticalAlignment="Top"
                                  Margin="0,3,0,0"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <Grid Grid.Row="3" Padding="14,8">
            <HyperlinkButton Content="Quit" HorizontalAlignment="Right" FontSize="11" Click="OnQuit" />
        </Grid>
    </Grid>
</UserControl>
