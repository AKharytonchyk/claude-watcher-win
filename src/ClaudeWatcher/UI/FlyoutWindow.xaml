<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeWatcher.UI.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ClaudeWatcher.Core"
    xmlns:ui="using:ClaudeWatcher.UI">

    <Grid x:Name="Root" Width="340" Padding="0" RowSpacing="0"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.Resources>
            <ui:StateToBrushConverter x:Key="StateBrush" />
            <ui:ContextPctConverter x:Key="Pct" />
            <ui:BoolToVisibilityConverter x:Key="BoolVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="14,10" Spacing="2">
            <TextBlock Text="Claude Agents" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind VM.Summary, Mode=OneWay}" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="No running agents"
                   Visibility="{x:Bind VM.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}"
                   HorizontalAlignment="Center" Margin="0,28" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Rows -->
        <ListView Grid.Row="2" x:Name="AgentList"
                  ItemsSource="{x:Bind VM.Agents, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="OnItemClick"
                  SelectionMode="None" Padding="6,4"
                  Visibility="{x:Bind VM.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                  MaxHeight="440">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:AgentView">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"
                                 Fill="{x:Bind State, Converter={StaticResource StateBrush}}" />

                        <StackPanel Grid.Column="1" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StateText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind Intent}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Origin}" FontSize="10.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Branch}" FontSize="10.5"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ContextPct, Converter={StaticResource Pct}}" FontSize="10"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer -->
        <Grid Grid.Row="3" Padding="14,8" ColumnSpacing="8">
            <HyperlinkButton Content="Quit" HorizontalAlignment="Right" FontSize="11" Click="OnQuit" />
        </Grid>
    </Grid>
</Window>
