<?xml version="1.0" encoding="utf-8"?>
<!-- Bare host window: content is a FlyoutView (UserControl) set in code-behind,
     because a Window is not a FrameworkElement and can't host x:Bind directly. -->
<Window
    x:Class="ClaudeWatcher.UI.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
</Window>
