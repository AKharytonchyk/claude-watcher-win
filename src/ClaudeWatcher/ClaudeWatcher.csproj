<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClaudeWatcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: no MSIX required. Keeps distribution lean (Constitution §3). -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Carry the Windows App SDK with us. An unpackaged app otherwise needs a
         matching Windows App Runtime *and* its DDLM registered; a machine with only
         the framework package (common — they arrive as dependencies of other apps)
         dies at startup with 0x80670016, "Package dependency criteria could not be
         resolved", before any of our code runs. This is the "runtime provisioning"
         risk in specs/0001 — self-contained retires it. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Release carries the .NET runtime too, so a target machine needs nothing
         installed at all (~220 MB, 500+ files — WinUI can't be trimmed). Debug stays
         framework-dependent to keep the edit/run loop quick. -->
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Local builds carry this; the release workflow overrides it from the git tag. -->
    <Version>0.1.0</Version>
    <Product>Claude Watcher</Product>
    <Authors>Artsiom Kharytonchyk</Authors>
    <Copyright>© 2026 Artsiom Kharytonchyk</Copyright>
  </PropertyGroup>

  <!-- On net10 both former pins are gone: H.NotifyIcon 2.4+ requires net10 (it had
       held us at 2.3.0), and Windows App SDK 2.3.x is the line whose runtime ships
       with a DDLM registered on current Windows boxes. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeWatcher.Core\ClaudeWatcher.Core.csproj" />
  </ItemGroup>

</Project>
